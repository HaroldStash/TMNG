<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="using:Tmng.App.Theme">
  <!-- Every colour the chrome uses, per theme. Graph and meter colours come from InkSet instead. -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WindowBg" Color="#0D1015" />
      <SolidColorBrush x:Key="SidebarBg" Color="#11151B" />
      <SolidColorBrush x:Key="SidebarBorder" Color="#222932" />
      <SolidColorBrush x:Key="PanelBg" Color="#141920" />
      <SolidColorBrush x:Key="PanelBorder" Color="#29313B" />
      <BoxShadows x:Key="PanelShadow">0 0 0 0 #00000000</BoxShadows>
      <SolidColorBrush x:Key="CardBg" Color="#181D24" />
      <SolidColorBrush x:Key="TextStrong" Color="#E6EAF0" />
      <SolidColorBrush x:Key="TextBody" Color="#D5DBE3" />
      <SolidColorBrush x:Key="TextCaption" Color="#9AA4B2" />
      <SolidColorBrush x:Key="TextSection" Color="#6F7A88" />
      <SolidColorBrush x:Key="IconMuted" Color="#C9D1DB" />
      <SolidColorBrush x:Key="NavSelected" Color="#1F3A66" />
      <SolidColorBrush x:Key="DeviceSelected" Color="#262C35" />
      <SolidColorBrush x:Key="Brand" Color="#4C8DFF" />
      <SolidColorBrush x:Key="WarningBg" Color="#2A2210" />
      <SolidColorBrush x:Key="WarningBorder" Color="#6B5418" />
      <SolidColorBrush x:Key="Warning" Color="#FFB020" />
      <SolidColorBrush x:Key="Danger" Color="#B8461E" />
      <SolidColorBrush x:Key="Overlay" Color="#B3000000" />
      <SolidColorBrush x:Key="CpuText" Color="#4CFF6A" />
      <SolidColorBrush x:Key="GpuText" Color="#7FA8FF" />
      <SolidColorBrush x:Key="ThermalText" Color="#FF9F2E" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WindowBg" Color="#EEF1F5" />
      <SolidColorBrush x:Key="SidebarBg" Color="#E3E8EE" />
      <SolidColorBrush x:Key="SidebarBorder" Color="#CBD2DC" />
      <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PanelBorder" Color="#D3D9E1" />
      <BoxShadows x:Key="PanelShadow">0 1 3 0 #18000000</BoxShadows>
      <SolidColorBrush x:Key="CardBg" Color="#F6F8FA" />
      <SolidColorBrush x:Key="TextStrong" Color="#161B22" />
      <SolidColorBrush x:Key="TextBody" Color="#27303B" />
      <SolidColorBrush x:Key="TextCaption" Color="#5B6573" />
      <SolidColorBrush x:Key="TextSection" Color="#7A8594" />
      <SolidColorBrush x:Key="IconMuted" Color="#3A4250" />
      <SolidColorBrush x:Key="NavSelected" Color="#CFE0FA" />
      <SolidColorBrush x:Key="DeviceSelected" Color="#E1E7EF" />
      <SolidColorBrush x:Key="Brand" Color="#2563EB" />
      <SolidColorBrush x:Key="WarningBg" Color="#FFF4DB" />
      <SolidColorBrush x:Key="WarningBorder" Color="#E8C36A" />
      <SolidColorBrush x:Key="Warning" Color="#B7791F" />
      <SolidColorBrush x:Key="Danger" Color="#C2410C" />
      <SolidColorBrush x:Key="Overlay" Color="#80202833" />
      <SolidColorBrush x:Key="CpuText" Color="#1E8F36" />
      <SolidColorBrush x:Key="GpuText" Color="#2563EB" />
      <SolidColorBrush x:Key="ThermalText" Color="#C2610C" />
    </ResourceDictionary>

    <!-- Darker than Dark so the glow has something to light up; borders carry a cool tint. -->
    <ResourceDictionary x:Key="{x:Static t:ThemeState.NeonVariant}">
      <SolidColorBrush x:Key="WindowBg" Color="#05070A" />
      <SolidColorBrush x:Key="SidebarBg" Color="#080B10" />
      <SolidColorBrush x:Key="SidebarBorder" Color="#14303D" />
      <SolidColorBrush x:Key="PanelBg" Color="#0A0E14" />
      <SolidColorBrush x:Key="PanelBorder" Color="#183847" />
      <BoxShadows x:Key="PanelShadow">0 0 16 0 #183DE8FF</BoxShadows>
      <SolidColorBrush x:Key="CardBg" Color="#0D131B" />
      <SolidColorBrush x:Key="TextStrong" Color="#EAF6FF" />
      <SolidColorBrush x:Key="TextBody" Color="#D3E4F0" />
      <SolidColorBrush x:Key="TextCaption" Color="#8BA3B5" />
      <SolidColorBrush x:Key="TextSection" Color="#4A8DAE" />
      <SolidColorBrush x:Key="IconMuted" Color="#BFE6FF" />
      <SolidColorBrush x:Key="NavSelected" Color="#0E3550" />
      <SolidColorBrush x:Key="DeviceSelected" Color="#0F2633" />
      <SolidColorBrush x:Key="Brand" Color="#3DE8FF" />
      <SolidColorBrush x:Key="WarningBg" Color="#1C1505" />
      <SolidColorBrush x:Key="WarningBorder" Color="#8A6A12" />
      <SolidColorBrush x:Key="Warning" Color="#FFC23D" />
      <SolidColorBrush x:Key="Danger" Color="#D9481C" />
      <SolidColorBrush x:Key="Overlay" Color="#CC000000" />
      <SolidColorBrush x:Key="CpuText" Color="#4CFF6A" />
      <SolidColorBrush x:Key="GpuText" Color="#7FB2FF" />
      <SolidColorBrush x:Key="ThermalText" Color="#FFAA44" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
