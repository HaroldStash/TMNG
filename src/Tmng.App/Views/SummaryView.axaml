<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tmng.App.ViewModels"
             xmlns:c="using:Tmng.App.Controls"
             x:Class="Tmng.App.Views.SummaryView"
             x:DataType="vm:SummaryViewModel">
  <Grid RowDefinitions="1.45*,*,Auto" RowSpacing="10">

    <Grid ColumnDefinitions="Auto,1.9*,1.3*" ColumnSpacing="10">

      <!-- Meter column -->
      <Border Classes="panel" Padding="14,10">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <TextBlock Grid.Column="0" Text="CPU" Classes="caption" Foreground="{Binding Inks.Cpu.Brush}" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Clock" Classes="caption" Foreground="{Binding Inks.Clock.Brush}" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Temp" Classes="caption" Foreground="{Binding Inks.Temp.Brush}" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="GPU" Classes="caption" Foreground="{Binding Inks.Gpu.Brush}" HorizontalAlignment="Center" />

          <c:VfdMeter Grid.Row="1" Grid.Column="0" Width="38" Margin="0,8" Segments="26" Value="{Binding CpuMeter}" Accent="{Binding Inks.Cpu.Accent}" />
          <c:VfdMeter Grid.Row="1" Grid.Column="1" Width="38" Margin="0,8" Segments="26" Value="{Binding ClockMeter}" Accent="{Binding Inks.Clock.Accent}" />
          <c:VfdMeter Grid.Row="1" Grid.Column="2" Width="38" Margin="0,8" Segments="26" Value="{Binding TempMeter}" Accent="{Binding Inks.Temp.Accent}" />
          <c:VfdMeter Grid.Row="1" Grid.Column="3" Width="38" Margin="0,8" Segments="26" Value="{Binding GpuMeter}" Accent="{Binding Inks.Gpu.Accent}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding CpuText}" Classes="mono" Foreground="{Binding Inks.Cpu.Brush}" HorizontalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClockText}" Classes="mono" Foreground="{Binding Inks.Clock.Brush}" HorizontalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TempText}" Classes="mono" Foreground="{Binding Inks.Temp.Brush}" HorizontalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding GpuText}" Classes="mono" Foreground="{Binding Inks.Gpu.Brush}" HorizontalAlignment="Center" />
        </Grid>
      </Border>

      <!-- CPU overview -->
      <Border Grid.Column="1" Classes="panel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <TextBlock Classes="glyph" Text="&#xE950;" Foreground="{DynamicResource IconMuted}" />
            <TextBlock Grid.Column="1" Text="CPU Overview" Classes="title" />
            <TextBlock Grid.Column="2" Text="{Binding CpuText}" Classes="value" Foreground="{Binding Inks.Cpu.Brush}" />
          </Grid>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="18" Margin="0,6,0,8">
            <TextBlock Text="● Utilization" Classes="caption" Foreground="{Binding Inks.Cpu.Brush}" />
            <TextBlock Text="● Temperature (0–110 °C)" Classes="caption" Foreground="{Binding Inks.Thermal.Brush}" />
            <TextBlock Text="● Kernel" Classes="caption" Foreground="{Binding Inks.Kernel.Brush}" />
          </StackPanel>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock Text="{Binding CpuFooter}" Classes="caption" />
            <TextBlock Grid.Column="1" Text="{Binding ClockFooter}" Classes="caption" />
          </Grid>
          <c:TraceGraph Lines="{Binding CpuLines}" Generation="{Binding Generation}" />
        </DockPanel>
      </Border>

      <!-- Top processes -->
      <Border Grid.Column="2" Classes="panel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <TextBlock Classes="glyph" Text="&#xE8FD;" Foreground="{DynamicResource IconMuted}" />
            <TextBlock Grid.Column="1" Text="Top CPU processes" Classes="title" />
            <TextBlock Grid.Column="2" Text="{Binding ProcessTotal}" Classes="caption" VerticalAlignment="Center" />
          </Grid>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="64,*,64,52,82" Margin="0,10,0,4">
            <TextBlock Text="PID" Classes="caption" HorizontalAlignment="Right" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="Name" Classes="caption" />
            <TextBlock Grid.Column="2" Text="CPU" Classes="caption" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="GPU" Classes="caption" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="Memory" Classes="caption" HorizontalAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding TopProcesses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TopProcessRow">
                <Grid ColumnDefinitions="64,*,64,52,82" Height="23">
                  <TextBlock Text="{Binding Pid}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Cpu}" Classes="mono" Foreground="{DynamicResource CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Gpu}" Classes="mono" Foreground="{DynamicResource GpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding Memory}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Memory -->
    <Border Grid.Row="1" Classes="panel">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
        <Grid RowDefinitions="*,Auto">
          <c:VfdMeter Width="64" Segments="20" Value="{Binding MemoryMeter}" Accent="{Binding Inks.Memory.Accent}" />
          <TextBlock Grid.Row="1" Text="{Binding MemoryPercentText}" Classes="mono" Foreground="{Binding Inks.Memory.Brush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </Grid>
        <DockPanel Grid.Column="1">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="Memory Utilization" Classes="title" />
            <TextBlock Grid.Column="1" Text="{Binding MemoryText}" Classes="value" Foreground="{DynamicResource TextStrong}" />
          </Grid>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*,*" Margin="0,8,0,0">
            <TextBlock Text="{Binding MemoryAvailable}" Classes="caption" />
            <TextBlock Grid.Column="1" Text="{Binding MemoryCached}" Classes="caption" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding MemoryCommitted}" Classes="caption" HorizontalAlignment="Right" />
          </Grid>
          <c:TraceGraph Lines="{Binding MemoryLines}" Generation="{Binding Generation}" />
        </DockPanel>
      </Grid>
    </Border>

    <!-- Tiles -->
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Tiles}" Margin="-5">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" Rows="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TileViewModel">
          <Border Classes="panel" Margin="5" Height="108" Background="{Binding Ink.Panel}" BorderBrush="{Binding Ink.Border}">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Classes="glyph" Text="{Binding Glyph}" Foreground="{Binding Ink.Brush}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="title" />
                <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="value" Foreground="{Binding Ink.Brush}" />
              </Grid>
              <TextBlock Grid.Row="1" Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
              <c:VfdMeter Grid.Row="2" Orientation="Horizontal" Segments="34" Height="20" VerticalAlignment="Bottom"
                          Value="{Binding Bar}" Accent="{Binding Ink.Accent}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
