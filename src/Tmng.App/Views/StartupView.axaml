<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tmng.App.ViewModels"
             x:Class="Tmng.App.Views.StartupView"
             x:DataType="vm:StartupViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <Border Classes="panel">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="BOOT" Classes="section" />
          <TextBlock Text="{Binding BootHeadline}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding BootDetail}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding BootHistory}" VerticalAlignment="Bottom">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BootBar">
              <StackPanel Width="34" Spacing="2" ToolTip.Tip="{Binding Tip}">
                <TextBlock Text="{Binding Total}" FontSize="10.5" HorizontalAlignment="Center" Classes="mono" />
                <Panel Height="64">
                  <StackPanel VerticalAlignment="Bottom">
                    <Border Height="{Binding AfterHeight}" Background="{DynamicResource Brand}" Opacity="0.45" CornerRadius="2,2,0,0" />
                    <Border Height="{Binding DesktopHeight}" Background="{DynamicResource Brand}" />
                  </StackPanel>
                </Panel>
                <TextBlock Text="{Binding Date}" FontSize="10.5" HorizontalAlignment="Center" Classes="caption" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="panel" Padding="0">
      <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                GridLinesVisibility="None" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn x:DataType="vm:StartupRow" Header="Name" Binding="{Binding Name}" Width="1.3*" />
          <DataGridTextColumn x:DataType="vm:StartupRow" Header="Publisher" Binding="{Binding Publisher}" Width="*" />
          <DataGridTextColumn x:DataType="vm:StartupRow" Header="Status" Binding="{Binding Status}" Width="90" />
          <DataGridTextColumn x:DataType="vm:StartupRow" Header="Startup impact" Binding="{Binding Impact}" SortMemberPath="ImpactRank" Width="150" />
          <DataGridTextColumn x:DataType="vm:StartupRow" Header="CPU" Binding="{Binding Cpu}" SortMemberPath="CpuValue" Width="80" />
          <DataGridTextColumn x:DataType="vm:StartupRow" Header="Disk" Binding="{Binding Disk}" SortMemberPath="DiskValue" Width="90" />
          <DataGridTextColumn x:DataType="vm:StartupRow" Header="Source" Binding="{Binding Location}" Width="1.2*" />
          <DataGridTextColumn x:DataType="vm:StartupRow" Header="Command" Binding="{Binding Command}" Width="2.4*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="2" Classes="panel">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding Summary}" Classes="caption" />
          <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap" FontSize="13"
                     IsVisible="{Binding ActionMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Button Content="Enable" Command="{Binding EnableCommand}" />
          <Button Content="Disable" Command="{Binding DisableCommand}" />
          <Button Content="Open file location" Command="{Binding RevealCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
